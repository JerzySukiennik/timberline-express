; Engine configuration file.

config_version=5

[application]

config/name="Timberline Express"
config/description="Co-op survival on rails in a mountain forest."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07, 0.08, 0.08, 1)
boot_splash/minimum_display_time=0

[autoload]

Controls="*res://scripts/core/controls.gd"
Sfx="*res://scripts/core/sfx.gd"
Items="*res://scripts/core/items.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
jolt_physics_3d/simulation/penetration_slop=0.005

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
environment/ssao/quality=1
environment/ssao/half_size=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
